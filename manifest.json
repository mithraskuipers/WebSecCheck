{
  "manifest_version": 3,
  "name": "WebSec Header & Cookie Auditor",
  "version": "1.0.0",
  "description": "Audits response security headers and cookie attributes for the active tab.",
  "permissions": ["activeTab", "cookies", "webRequest", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebSec Auditor"
  }
}
